# ============================================================================
# RDM DIGITAL HUB — NODO CERO · Variables de entorno
# Despliegue en Vercel: Dashboard del proyecto → Settings → Environment Variables
# ============================================================================

# Isabella opera en vivo cuando alguna clave de la bóveda CROWN está
# configurada. Sin ninguna, Isabella responde en "modo simulación" con
# respuestas locales soberanas (SOPHIA), sin salida de datos.

# APP_URL: URL pública donde quedará alojada la plataforma (Vercel deployment URL
# o dominio personalizado). Se usa para enlaces autorreferenciales y APIs.
# En Vercel, nodo-cero vive en su propio subdominio API:
APP_URL="https://api.visitarealdelmonte.online"

# Otras variables opcionales:
# NEXT_PUBLIC_SITE_URL  → URL pública (para metadatos/OG) si APP_URL no basta.
#   Valor recomendado en producción: https://api.visitarealdelmonte.online

# ============================================================================
# PERSISTENCIA — Neon Postgres (integración automática en Vercel)
# ============================================================================
# La integración "Neon" en Vercel (Settings → Integrations) inyecta este
# conjunto de variables a todos los entornos. Uso que hace el Nodo:
#
#   DATABASE_URL             → URL completa (pooled, PgBouncer de Neon).
#   DATABASE_URL_UNPOOLED    → URL completa directa (sin pooler) para
#                              migraciones y operaciones transaccionales.
#   POSTGRES_PRISMA_URL      → URL pooled compatible con Prisma (se lee con
#                              prioridad como URL completa).
#   PGHOST                   → hostname del endpoint pooled (-pooler).
#   PGHOST_UNPOOLED          → hostname del endpoint directo.
#   PGUSER                   → usuario de la base de datos.
#   POSTGRES_PASSWORD        → contraseña de la base de datos.
#   PGDATABASE               → nombre de la base (default: neondb).
#   PGPORT                   → puerto (default: 5432; pooled/directo).
#
# El resolver de lib/core/persistence/postgres.ts usa primero una URL
# completa (POSTGRES_PRISMA_URL / DATABASE_URL / DATABASE_URL_UNPOOLED) y,
# si no hay, reconstruye la URL desde los componentes (PGHOST*/PGUSER/...).
#
# Variables de Neon Auth (reservadas para autenticación de BD; NO se usan
# en la capa de persistencia):
#   VITE_NEON_AUTH_URL       → URL del proyecto Neon para la consola de Auth.
#   NEON_AUTH_BASE_URL       → base URL del servicio de autenticación.
#
# Límites del plan Free de Neon (por proyecto y mes):
#   100 CU-hours de cómputo · 0.5 GB de almacenamiento · 5 GB de egress ·
#   scale-to-zero a los 5 min de inactividad · hasta 10,000 conexiones
#   cliente vía PgBouncer (la computa acepta ~104).
# El Nodo aplica un presupuesto de cómputo que degrada a modo demo antes
# de agotarlo y espacia los pings de salud para no mantener la computa
# despierta.
#
# NEON_CU_HOURS_LIMIT: horas de cómputo permitidas al mes (default 100).
# NEON_PING_COOLDOWN_MS: mínimo entre pings de salud en ms (default 300000,
# 5 min → respeta el scale-to-zero).
NEON_CU_HOURS_LIMIT="100"
NEON_PING_COOLDOWN_MS="300000"

# ============================================================================
# FRONTERA — política canónica de origen (anti-CSRF / CORS)
# ============================================================================
# En Vercel cada app vive en su propio subdominio:
#   www.visitarealdelmonte.online   → visitor-web (público)
#   admin.visitarealdelmonte.online → admin-os (gestión)
#   api.visitarealdelmonte.online   → nodo-cero (esta API)
# El apex (visitarealdelmonte.online) responde 308 (permanent redirect) al
# canónico en el edge, así que nunca se renderiza.
#
# CANONICAL_ORIGINS: lista separada por comas de orígenes exactos permitidos
#   (los subdominios que llaman a esta API):
#   Ej: "https://www.visitarealdelmonte.online,https://admin.visitarealdelmonte.online"
# TRUSTED_HOSTS: lista separada por comas de hostnames que el Nodo reconoce
#   como propios cuando NO hay orígenes canónicos configurados. Un Host que
#   no esté aquí es rechazado (fail-closed). El fallback de self-origin es
#   SOLO un mecanismo de recuperación de configuración incompleta, nunca
#   la configuración definitiva.
#   Ej: "api.visitarealdelmonte.online,www.visitarealdelmonte.online,admin.visitarealdelmonte.online,visitarealdelmonte.online"
CANONICAL_ORIGINS="https://www.visitarealdelmonte.online,https://admin.visitarealdelmonte.online"
TRUSTED_HOSTS="api.visitarealdelmonte.online,www.visitarealdelmonte.online,admin.visitarealdelmonte.online,visitarealdelmonte.online"

# MEXA_OPERATOR_KEY: Secreto del operador para la Mexa API.
# Habilita el endpoint /api/isabella/crypto/sign (firmas MSR).
# Sin este secreto, los endpoints de firma responden 503 y solo /verify queda público.
MEXA_OPERATOR_KEY=""

# ============================================================================
# CROWN GATEWAY — Bóveda nativa de IAs open source + agentes de ingeniería
# Cada clave configura un proveedor más de la bóveda (Llama, Qwen, DeepSeek,
# Mistral, Phi, Cerebras). Sin claves, el Nodo opera en modo simulación
# soberano (SOPHIA local, sin egress). La bóveda también registra agentes de
# ingeniería del Nodo (kind 'agent', siempre presentes y sin egress) que no
# requieren clave y no participan en cadenas de inferencia.
# ============================================================================

# Bóveda open source — modelos servidos por transportes soberanos:
GROQ_API_KEY=""             # Llama 3.3 70B (Groq LPU)
OPENROUTER_API_KEY=""       # Qwen 2.5 72B / DeepSeek V3
CEREBRAS_API_KEY=""         # Llama 3.3 70B (Cerebras)
MISTRAL_API_KEY=""          # Mistral Nemo
CLOUDFLARE_AI_KEY=""        # Phi-3.5 Mini (junto a CLOUDFLARE_AI_ACCOUNT_ID)
CLOUDFLARE_AI_ACCOUNT_ID=""
OPENCODE_ZEN_API_KEY=""     # OpenCode Zen (Chat Completions en opencode.ai/zen/v1)
OPENCODE_SERVICES_API_KEY="" # Integración de servicios OpenCode <-> Isabella

# OLLAMA_BASE_URL: modelo local (zona roja, cero salida de datos).
# Ej: http://localhost:11434/v1 (endpoint OpenAI-compatible de Ollama)
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1"

# CROWN_EMERGENCY_KEY: clave del operador para armar/desarmar el LOCKDOWN
# (POST /api/isabella/gateway/emergency). Si no se define, el Dead Man's
# Switch solo puede renovarse con 'heartbeat'.
CROWN_EMERGENCY_KEY=""

# CROWN_HEARTBEAT_TTL_MS: ventana del Dead Man's Switch (por defecto 60_000).
# Si el operador deja de emitir latidos más de este tiempo, el Nodo entra en
# LOCKDOWN automáticamente.
CROWN_HEARTBEAT_TTL_MS="60000"

# ============================================================================
# GAMIFICATION YUN — Zombies RDM Invasion (server-authoritative)
# ============================================================================

# GAMIFICATION_HMAC_SECRET: firma HMAC-SHA256 de los tokens de sesión de juego.
# El backend valida integridad y caducidad de cada evento antes de otorgar
# puntos (anti-cheat). Sin este secreto el Nodo opera en modo 'open' (demo):
# se validan estructura, caducidad y vínculo deviceId↔sesión, sin integridad
# criptográfica. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAMIFICATION_HMAC_SECRET=""

# ============================================================================
# YUN QUANTUM SEMANTIC CORE — proveedor criptográfico híbrido (fail-closed)
# ============================================================================
# YUN_CRYPTO_PROVIDER: motor que sella el sobre semántico con firma híbrida
# (Ed25519 clásica + ML-DSA-65 post-cuántica). Hoy solo está registrado
# 'unconfigured': sin proveedor auditado, el sellado falla cerrado con
# CRYPTO_PROVIDER_NOT_CONFIGURED y /api/yun/envelope/verify responde 503.
# NO se implementa ML-KEM/ML-DSA manualmente; se exigirá un motor externo
# auditado (KMS/HSM con KAT vectors e interoperabilidad) al habilitarlo.
YUN_CRYPTO_PROVIDER="unconfigured"

# ============================================================================
# CLAVES INTERNAS (Key Vault) — autenticación entre módulos del Nodo
# Cada clave alimenta una capa de identidad de la cadena Zero Trust.
# Rotación: añade _V2/_V3 al nombre para escalar versiones sin downtime.
# Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ISA_API_KEY: autenticación del núcleo cognitivo ISA (capa de identidad L6).
ISA_API_KEY=""

# MEXA_API_KEY: autenticación de la API interna MEXA (firmas MSR).
MEXA_API_KEY=""

# GAMIFICATION_API_KEY: autorización del motor de juego / anti-cheat.
GAMIFICATION_API_KEY=""

# MONITOR_API_KEY: acceso de solo lectura al Monitor General (/api/monitor/*).
MONITOR_API_KEY=""

# CROWN_API_KEY: autenticación de la flota de agentes CROWN (open science).
CROWN_API_KEY=""

# RDM_ADMIN_API_KEY: bootstrap de la primera clave admin de IDENTITY YUN.
# Si el registro de identidad está vacío, esta clave se da de alta como
# `admin:keys` + `admin:all` en el arranque (siempre se almacena como hash
# scrypt, jamás en claro). Genera una con:
#   node -e "console.log('rdm_live_' + require('crypto').randomBytes(32).toString('base64url'))"
RDM_ADMIN_API_KEY=""

# ============================================================================
# PROVEEDORES LLM — CROWN Gateway (flota federada de IAs)
# Cada clave activa el proveedor homólogo en lib/isabella/crown-gateway.ts.
# Sin claves, Isabella opera en modo simulación local soberano (SOPHIA).
# ============================================================================
GROQ_API_KEY=""             # Llama 3.3 70B (Groq LPU)
CEREBRAS_API_KEY=""         # Llama 3.3 70B (Cerebras)
OPENROUTER_API_KEY=""       # Qwen 2.5 72B / DeepSeek V3
MISTRAL_API_KEY=""          # Mistral Nemo
CLOUDFLARE_AI_KEY=""        # Workers AI (acompaña a CLOUDFLARE_AI_ACCOUNT_ID)
CLOUDFLARE_AI_ACCOUNT_ID=""
OLLAMA_BASE_URL=""          # Inferencia local (egress: blocked, nunca sale del Nodo)

# ============================================================================
# SPOTIFY — Panel de gestión multimedia del Nodo
# App "RDM DIGITAL HUB" registrada en developers.spotify.com.
# Flujo Authorization Code + PKCE. El token del usuario autorizado se guarda
# en memoria del runtime (globalThis) y se refresca automáticamente.
# ============================================================================
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Producción: https://www.visitarealdelmonte.online/api/spotify/auth/callback
# Desarrollo: http://localhost:3000/api/spotify/auth/callback
SPOTIFY_REDIRECT_URI=""
# Ámbitos por defecto (separados por espacio): historial, listas, biblioteca,
# reproducción con Web Playback SDK y perfil del usuario.
SPOTIFY_SCOPES="user-read-recently-played playlist-read-private playlist-read-collaborative user-library-read user-read-playback-state user-modify-playback-state streaming user-read-email user-read-private"

# ============================================================================
# LICENCIAMIENTO — sello de integridad del build
# BUILD_SEAL_KEY: clave HMAC para firmar el sello de versión del Nodo
# (manifiesto de integridad del build para licenciamiento). Sin esta clave
# el Nodo opera con sello 'open' (sin integridad criptográfica). Genera una
# con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
BUILD_SEAL_KEY=""

