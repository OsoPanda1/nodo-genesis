# Global Config
PROJECT_NAME=RDM_SOVEREIGN
ENVIRONMENT=production
DOMAIN=visitarealdelmonte.online
SSL_ENABLED=true

# API Core
CORE_PORT=8000
DATABASE_URL=mongodb://mongo:27017/tamv_db

# Apps
VISITOR_PORT=8080
ADMIN_OS_PORT=3000

# Infrastructure
NODO_ID=RDM-N0-ALPHA

# URLs absolutas de producción
BASE_URL=https://visitarealdelmonte.online
