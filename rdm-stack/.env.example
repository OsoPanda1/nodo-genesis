# Global Config
PROJECT_NAME=RDM_SOVEREIGN
ENVIRONMENT=development
DOMAIN=rdm.local
SSL_ENABLED=false

# API Core (tamv-core SSR)
CORE_PORT=8000

# Base de Datos Federada (PostgreSQL)
POSTGRES_USER=rdm
POSTGRES_PASSWORD=rdm
POSTGRES_DB=rdm_db
DATABASE_URL=postgres://rdm:rdm@db:5432/rdm_db

# Apps
VISITOR_PORT=8080
ADMIN_OS_PORT=3000

# Sistema Operativo Territorial (nodo-cero)
NODO_ID=RDM-N0-ALPHA
NODO_PORT=3100

# Supabase (build args de las SPAs) — sustituir por tus valores de proyecto
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_anon_key_publica

# URLs
BASE_URL=http://localhost
API_URL=http://localhost/api